[Unit]
Description=ErsatzTV YouTube Downloader 2.2
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=joaopaulovaz
Group=joaopaulovaz
WorkingDirectory=/opt/ersatztv-youtube-downloader
ExecStart=/usr/bin/node src/main.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
Environment=NODE_ENV=production

# Hardening moderado. Confirme que WorkingDirectory, paths.baseDir e cookies.txt
# permanecem acessiveis antes de habilitar restricoes adicionais.
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
