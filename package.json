{
  "name": "ersatztv-youtube-downloader",
  "version": "4.2.1",
  "description": "Gerenciador privado de bibliotecas, canais e legendas para ErsatzTV/YouTube, com fila persistente, editor de legendas e Scripted Schedules.",
  "main": "src/main.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/main.js",
    "sync": "node src/cli-sync.js",
    "discover": "node src/cli-sync.js",
    "auth:set": "node src/cli-auth.js",
    "check": "node scripts/check-syntax.js",
    "test": "node scripts/run-tests.js",
    "verify:release": "node scripts/verify-release.js",
    "verify": "npm run check && npm test && npm run verify:release"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "ersatztv",
    "youtube",
    "yt-dlp",
    "playlist",
    "downloader",
    "mp4",
    "scheduler",
    "authentication"
  ],
  "author": "",
  "license": "MIT"
}
