{
  "configVersion": 2,
  "server": {
    "host": "0.0.0.0",
    "port": 3099
  },
  "paths": {
    "baseDir": "/srv/media/youtube",
    "ytDlpPath": "/usr/local/bin/yt-dlp",
    "ffmpegPath": "/usr/bin/ffmpeg",
    "ffprobePath": "/usr/bin/ffprobe",
    "cookiesPath": ""
  },
  "downloads": {
    "maxHeight": 1080,
    "container": "mp4",
    "codecProfile": "mp4_h264_aac",
    "concurrentDownloads": 1,
    "userAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
    "jsRuntimeMode": "deno",
    "jsRuntimePath": "/usr/local/bin/deno",
    "jsRuntimeCustomName": "deno",
    "ejsComponents": "ejs:github",
    "writeThumbnails": true,
    "updateExistingThumbnails": false,
    "pauseOnLowDisk": true,
    "minFreeSpaceGb": 20,
    "scanOnQueueIdle": true,
    "rebuildPlayoutOnQueueIdle": true,
    "idleActionDelaySeconds": 15,
    "retryDelaysMinutes": [
      1,
      5,
      15
    ]
  },
  "youtubeApi": {
    "enabled": false,
    "apiKey": "",
    "readMode": "api",
    "cacheTtlHours": 168,
    "timeoutSeconds": 20
  },
  "ersatztv": {
    "url": "http://localhost:8409",
    "apiTimeoutSeconds": 10,
    "apiKey": ""
  },
  "playlists": [
    {
      "name": "Mix_Principal",
      "url": "https://www.youtube.com/playlist?list=PL_EXEMPLO",
      "urls": [
        "https://www.youtube.com/playlist?list=PL_EXEMPLO"
      ],
      "enabled": true,
      "libraryId": null,
      "playoutId": null,
      "cookiesPath": "",
      "maxHeight": null,
      "subtitles": {
        "enabled": false,
        "includeAuto": true,
        "languages": [
          "pt-BR",
          "pt",
          "en",
          "es"
        ]
      },
      "movieMetadata": {
        "enabled": false
      }
    }
  ],
  "scheduler": {
    "enabled": false,
    "intervalMinutes": 360,
    "runOnStartup": false
  },
  "cleanup": {
    "removeEmptyArtistFolders": true
  }
}
